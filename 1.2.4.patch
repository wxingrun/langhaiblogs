+     * 根据文章ID获取评论列表
+     * 
+     * @param articleId 文章ID
+     * @return 评论列表
+     */
+    @ResponseBody
+    @GetMapping("/getCommentByArticleId")
+    public ResultResponse<List<ArticleComment>> getCommentByArticleId(Long articleId) {
+        if (articleId == null) {
+            return ResultResponse.fail();

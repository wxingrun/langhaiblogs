+                        $("#likeBtnNew").text("点赞");
+                    }
+                }
+            });
+
+            // 点赞/取消点赞按钮点击
+            $("#likeBtnNew").click(function () {
+                var url = isLiked ? "/articleLike/unlike" : "/articleLike/like";
